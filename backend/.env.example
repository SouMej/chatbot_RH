# Copiez ce fichier en .env et remplissez les valeurs
# NE JAMAIS committer le fichier .env reel (ajoutez-le a .gitignore)

# Cle secrete utilisee pour signer les tokens JWT.
# Generez-en une avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changez_moi_avec_une_vraie_cle_secrete_aleatoire

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Duree de validite du lien de verification d'email (en minutes)
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440

# URL de base du frontend, utilisee pour construire le lien de verification
FRONTEND_URL=http://localhost:5173

# Mode d'envoi d'email : "console" (affiche le lien dans les logs, pour test local)
# ou "smtp" (envoi reel, necessite de remplir les champs SMTP_* ci-dessous)
EMAIL_MODE=console

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.adresse@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_application

# --- Chatbot RAG ---
# Dossiers generes par indexation.py (voir le script deja fourni)
CHROMA_DB_DIR=./chroma_db
DOCS_DIR=./docs_test

# Configuration Ollama (doit tourner en local : ollama run mistral)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=180
